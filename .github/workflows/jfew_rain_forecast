name: J-FEW Prakiraan curah hujan & analisis frekuensi

on:
  workflow_dispatch: {}
  schedule:
    - cron: "47 4 6 * *"     # tiap tanggal 6, 12:47 WITA (sehari setelah data satelit diperbarui)

jobs:
  forecast:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
      - run: pip install earthengine-api numpy pandas scipy statsmodels
      - name: Prakiraan tahun depan + Gumbel / Log-Pearson III
        env:
          EE_SERVICE_ACCOUNT_KEY: ${{ secrets.EE_SERVICE_ACCOUNT_KEY }}
          EE_PROJECT: ${{ secrets.EE_PROJECT }}
          JFEW_WEBAPP_URL: ${{ secrets.JFEW_WEBAPP_URL }}
          JFEW_BURN_TOKEN: ${{ secrets.JFEW_BURN_TOKEN }}
        run: python3 jfew_rain_forecast.py
